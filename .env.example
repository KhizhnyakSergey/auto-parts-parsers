AWE_BASE_URL=https://www.awe-tuning.com
AWE_CONCURRENCY=2
AWE_REQUEST_DELAY=0.6
AWE_PAGE_SIZE=250
AWE_TIMEOUT=20.0
AWE_MAX_RETRIES=6
# JSON array of browser fingerprints rotated per-request. Keep Chrome out of
# this list - the store's WAF has progressively rate-limited every Chrome
# fingerprint we tried, while Safari/Firefox/Edge stayed clean.
AWE_IMPERSONATE_POOL=["safari18_0","safari17_0","firefox133","firefox135","edge101"]
# JSON array of collection handles to skip on a full scrape (merch, not parts)
AWE_EXCLUDED_CATEGORIES=["gear-accessories"]
