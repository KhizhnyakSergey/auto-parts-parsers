AWE_BASE_URL=https://www.awe-tuning.com
AWE_CONCURRENCY=2
AWE_REQUEST_DELAY=0.6
AWE_PAGE_SIZE=250
AWE_TIMEOUT=20.0
AWE_MAX_RETRIES=6
# JSON array of browser fingerprints rotated per-request. Keep Chrome out of
# this list - the store's WAF has progressively rate-limited every Chrome
# fingerprint we tried, while Safari/Firefox/Edge stayed clean.
AWE_IMPERSONATE_POOL=["safari18_0","safari17_0","firefox133","firefox135","edge101"]
# JSON array of collection handles to skip on a full scrape (merch, not parts)
AWE_EXCLUDED_CATEGORIES=["gear-accessories"]

FLOWMASTER_BASE_URL=https://www.flowmastermufflers.com
FLOWMASTER_CONCURRENCY=2
FLOWMASTER_REQUEST_DELAY=0.6
FLOWMASTER_TIMEOUT=20.0
FLOWMASTER_MAX_RETRIES=6

# Optional: only needed if plain TLS impersonation starts getting soft-blocked
# (repeated 429s / re-issued Cloudflare challenge pages) during a large run.
# Capture from a browser that just solved the site's challenge - devtools ->
# Application -> Cookies -> flowmastermufflers.com for cf_clearance/__cf_bm,
# devtools -> Network -> any request -> User-Agent. cf_clearance expires
# (observed lifetime: well under a day), so this needs refreshing per run.
# Leave unset for normal use - TLS impersonation alone works most of the time.
# FLOWMASTER_CF_CLEARANCE=
# FLOWMASTER_CF_BM=
# FLOWMASTER_USER_AGENT=
